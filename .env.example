# Copie este arquivo para ".env" e preencha com os valores do seu banco Turso.
# Como obter: veja o README, seção "Banco de dados (Turso)".

TURSO_DATABASE_URL=libsql://seu-banco-sua-org.turso.io
TURSO_AUTH_TOKEN=

# Opcional: troque em produção por um valor secreto seu.
JWT_SECRET=brinca-e-sente-dev-secret-change-in-production

# Senha de acesso ao painel de vendas (CRM), em /admin.
ADMIN_PASSWORD=troque-esta-senha

# Opcional: cotação real de frete via Melhor Envio (Correios e outras
# transportadoras, sem precisar de contrato direto com os Correios).
# Crie uma conta gratuita em melhorenvio.com.br e gere um token de PRODUÇÃO
# (não use o sandbox.melhorenvio.com.br em produção — retorna preços fictícios).
# Sem essas variáveis, o site usa uma tabela de preços fixos por região.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_FROM_CEP=
MELHOR_ENVIO_BASE_URL=https://melhorenvio.com.br
MELHOR_ENVIO_CONTACT_EMAIL=contato@brincaesente.com.br
