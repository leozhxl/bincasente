# Copie este arquivo para ".env" e preencha com os valores do seu banco Turso.
# Como obter: veja o README, seção "Banco de dados (Turso)".

TURSO_DATABASE_URL=libsql://seu-banco-sua-org.turso.io
TURSO_AUTH_TOKEN=

# Opcional: troque em produção por um valor secreto seu.
JWT_SECRET=brinca-e-sente-dev-secret-change-in-production

# Cálculo de frete real via Melhor Envio (https://melhorenvio.com.br)
# Gere o token em: Painel > Gerenciar > Tokens de integração.
MELHOR_ENVIO_TOKEN=
# CEP de origem (endereço da loja), somente dígitos.
MELHOR_ENVIO_FROM_CEP=88970000
# https://api.melhorenvio.com.br em produção, https://sandbox.melhorenvio.com.br para testes.
MELHOR_ENVIO_BASE_URL=https://melhorenvio.com.br
MELHOR_ENVIO_CONTACT_EMAIL=brincaesente@gmail.com
